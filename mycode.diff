+int is_region_free(struct proc *p, uint64 start, uint64 end) {
+  for (int i = 0; i < NVMA; i++) {
+      struct vma *v = &p->vmas[i];
+      if (v->valid && !(end <= v->addr || start >= v->addr + v->length)) {
+          return 0; // 区域重叠
+      }
+  }
+  return 1; // 区域空闲
+}
